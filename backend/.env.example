# Server-side AI credentials (optional).
# Users can supply their own keys per-request from the app's Settings panel;
# these env vars act as fallback when a request omits them.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-1.5-flash

APP_HOST=127.0.0.1
APP_PORT=8000
APP_DEBUG=true
